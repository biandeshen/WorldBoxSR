{
  "name": "worldboxsr",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A deterministic emergent-world god-game sandbox.",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "sim": "node tools/simulate.js",
    "smoke": "node tools/simulate.js --seed 42 --years 20 --population 20 --quiet",
    "lab": "node simulation_lab/batch.js",
    "lab:parallel": "node simulation_lab/batch.js --workers 4",
    "scenario": "node simulation_lab/scenario_cli.js",
    "dev": "vite",
    "dev:legacy": "node tools/serve.js",
    "build": "vite build",
    "pages:build": "vite build && node tools/build-pages.js",
    "pages:check": "node tools/check-pages-build.js",
    "bench": "node tools/benchmark.js"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "vite": "8.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
